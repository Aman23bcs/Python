class Solution:
    def reverse(self, x: int) -> int:
        a=0
        negative=False
        if x<0:
            negative=True
            x*=-1
        while x>0:
            d=x%10
            a*=10
            a+=d
            x//=10
            if a>2**31-1:
                return 0
        if negative:
            return -1*a
        return a
        
